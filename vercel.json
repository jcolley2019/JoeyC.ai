{
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/blog/now-i-have-everything-i-need-let-me-write-the-full-blog-article",
      "destination": "/blog/openai-killed-sora-what-it-means-for-ai-creators",
      "permanent": true
    },
    {
      "source": "/rss",
      "destination": "/rss.xml",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/rss.xml",
      "destination": "/api/rss"
    },
    {
      "source": "/blog",
      "destination": "/api/blog"
    },
    {
      "source": "/blog/:slug",
      "destination": "/api/blog?slug=:slug"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/blog.ts": {
      "includeFiles": "dist/index.html"
    }
  }
}
